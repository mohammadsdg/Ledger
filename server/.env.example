NODE_ENV=production
PORT=4000
APP_PASSWORD=replace-with-a-long-random-password
SESSION_SECRET=replace-with-a-separate-long-random-secret

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=ledger
DB_PASSWORD=replace-with-the-mysql-user-password
DB_NAME=ledger
DB_POOL_SIZE=10

# Optional. Ledger generates and stores VAPID keys in MySQL automatically.
VAPID_SUBJECT=mailto:admin@example.com
